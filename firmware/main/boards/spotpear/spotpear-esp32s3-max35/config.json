{
    "manufacturer": "spotpear",
    "type": "spotpear-esp32s3-max35",
    "target": "esp32s3",
    "builds": [
        {
            "name": "spotpear-esp32s3-max35",
            "sdkconfig_append": [
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_LV_USE_TABVIEW=y",
                "CONFIG_LV_USE_TILEVIEW=y",
                "CONFIG_LWIP_SNTP_MAX_SERVERS=3",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"nuo mi nuo mi\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"糯米糯米\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=12",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y",
                "CONFIG_WAMR_ENABLE_AOT=n",
                "CONFIG_WAMR_ENABLE_LIB_PTHREAD=n",
                "CONFIG_WAMR_ENABLE_LIBC_WASI=n",
                "CONFIG_WAMR_ENABLE_APP_FRAMEWORK=n"
            ]
        }
    ]
}
